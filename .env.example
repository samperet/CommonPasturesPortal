# Cloudflare R2 — where all app data lives (JSON documents and images).
# Without these, data falls back to local .data/ files (ephemeral on Vercel).
# (src/lib/storage.ts also accepts R2_TOKEN_ID + R2_API_TOKEN in place of the
# access key pair, or everything in one JSON value as R2 / R2_CONFIG / R2_CREDENTIALS.)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Signs session cookies. Set a long random value in production.
AUTH_SECRET=""

# Enables the admin API: directory import (PUT /api/admin/directory) and photo seeding
# (POST /api/admin/photos). Leave unset to disable it.
ADMIN_TOKEN=""
# Extra app admins, as comma-separated directory person ids (Sam Peret is built in; more can be
# added on the Admin settings page)
ADMIN_PERSON_IDS=""

# Web push notifications (optional): generate with `npx web-push generate-vapid-keys`.
# Without them, the app generates a pair on first use and keeps it in storage.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:someone@example.org"

# Email (optional): sent through Brevo first and Resend when Brevo can't; with neither key nothing
# is emailed. Admins choose test mode and its allowed addresses at /admin/email. EMAIL_FROM's
# domain must be verified in both.
BREVO_KEY=
RESEND_KEY=
EMAIL_FROM=
# The app's address for links in emails (defaults to Vercel's production domain).
SITE_URL=

# Backups (optional): Vercel Cron sends CRON_SECRET to start the weekly backup (without it, only an
# admin's Export now makes one). A read-only token for this repository's contents puts the site's
# code in each backup; BACKUP_REPOSITORY (owner/name) if it isn't Vercel's own repository.
CRON_SECRET=
GITHUB_BACKUP_TOKEN=
# BACKUP_REPOSITORY=
# Locally only, for tests: copy backups to a stand-in bucket over plain http.
# BACKUP_STORAGE_ALLOW_HTTP=1

# OpenAI (optional), for two things:
# - drawing new circles' icons: its image model, given the other circles' icons as references.
#   Without OPENAI_KEY, new circles start without an icon (upload one as before).
# - reading photos of the printed duty calendar: the eggs written in each day's box, for someone
#   to check before they're saved. Without OPENAI_KEY, counts are typed in.
OPENAI_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_VISION_MODEL=gpt-5.6-sol
# Locally only (ignored on Vercel): answer from .data/egg-reader-fixture.json instead of the API.
# EGG_READER_TEST=1

# The email allowances (defaults: the free plans).
# BREVO_DAILY_LIMIT=300
# BREVO_MONTHLY_LIMIT=9000
# EMAIL_DAILY_LIMIT=100
# EMAIL_MONTHLY_LIMIT=3000

# Importing an Outline wiki (optional; admins, Admin → Import from Outline): the server's address
# and an Outline admin's API key (Outline: Settings → API). CVC only reads from it.
OUTLINE_URL=
OUTLINE_API_TOKEN=
